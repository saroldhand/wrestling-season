---
import Layout from '../layouts/Layout.astro';
import PracticeCard from '../components/PracticeCard.astro';
import { getCollection } from 'astro:content';
import { isInSeason, blockFor, weekdayOf, SEASON_START, SEASON_END } from '../lib/season.ts';

const practices = await getCollection('practices');
const moves = await getCollection('moves');
const blocks = await getCollection('blocks');

const byDate = new Map(practices.map((p) => [p.data.date, p.data]));
const moveNames = new Map(moves.map((m) => [m.data.id, m.data.name]));
const blockName = new Map(blocks.map((b) => [b.data.id, b.data.name]));

// Nov 2026 → Mar 2027, Monday-first grids.
const MONTHS = [
  { year: 2026, month: 10 },
  { year: 2026, month: 11 },
  { year: 2027, month: 0 },
  { year: 2027, month: 1 },
  { year: 2027, month: 2 },
];

const DAY_TAG: Record<string, string> = {
  install: 'INS',
  volume: 'VOL',
  sharpen: 'SHP',
  competition: 'COMP',
  off: 'OFF',
};

interface Cell {
  iso: string;
  num: number;
  inSeason: boolean;
  block: string | null;
  blockStartsHere: boolean;
  practice: (typeof practices)[number]['data'] | null;
  sunday: boolean;
}

function monthGrid(year: number, month: number) {
  const first = new Date(Date.UTC(year, month, 1));
  const label = new Intl.DateTimeFormat('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' }).format(first);
  const daysInMonth = new Date(Date.UTC(year, month + 1, 0)).getUTCDate();
  const lead = (first.getUTCDay() + 6) % 7; // Monday-first offset
  const cells: (Cell | null)[] = Array.from({ length: lead }, () => null);
  for (let d = 1; d <= daysInMonth; d++) {
    const iso = new Date(Date.UTC(year, month, d)).toISOString().slice(0, 10);
    const block = blockFor(iso);
    cells.push({
      iso,
      num: d,
      inSeason: isInSeason(iso),
      block,
      blockStartsHere: block !== null && blocks.some((b) => b.data.id === block && b.data.start === iso),
      practice: byDate.get(iso) ?? null,
      sunday: weekdayOf(iso) === 0,
    });
  }
  return { label, cells };
}

const grids = MONTHS.map(({ year, month }) => monthGrid(year, month));
const sortedPractices = [...practices].sort((a, b) => a.data.date.localeCompare(b.data.date));
---

<Layout title="Calendar" description="The season, November to March.">
  <h1>Season Calendar</h1>
  <p class="cal-legend" aria-label="Legend">
    {blocks
      .slice()
      .sort((a, b) => a.data.start.localeCompare(b.data.start))
      .map((b) => (
        <span class={`badge solid block-${b.data.id}`}>{b.data.name}</span>
      ))}
    <span class="legend-sep" aria-hidden="true">·</span>
    <span class="legend-item"><span class="comp-key" aria-hidden="true"></span> competition</span>
    <span class="legend-item"><span class="check-key" aria-hidden="true">✓</span> delivered</span>
    <span class="legend-item"><span class="flag-key" aria-hidden="true">!</span> past &amp; unfilled</span>
  </p>

  {grids.map(({ label, cells }) => (
    <section class="month">
      <h2>{label}</h2>
      <div class="grid" role="grid" aria-label={label}>
        {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
          <div class="dow" role="columnheader">{d}</div>
        ))}
        {cells.map((cell) =>
          cell === null ? (
            <div class="cell blank" aria-hidden="true"></div>
          ) : cell.practice ? (
            <button
              type="button"
              class={`cell day band-${cell.block}${cell.practice.day_type === 'competition' ? ' comp' : ''}${cell.practice.day_type === 'off' ? ' offday' : ''}`}
              data-date={cell.iso}
              data-status={cell.practice.status}
              id={cell.blockStartsHere ? `block-${cell.block}` : undefined}
              aria-label={`${cell.iso}, ${cell.practice.day_type}`}
            >
              <span class="num display">{cell.num}</span>
              <span class="tag">{DAY_TAG[cell.practice.day_type]}</span>
              {cell.practice.primary.length > 0 && (
                <span class="dots" aria-label={`${cell.practice.primary.length} primary moves`}>
                  {cell.practice.primary.slice(0, 4).map(() => <i></i>)}
                  {cell.practice.primary.length > 4 && <em>+{cell.practice.primary.length - 4}</em>}
                </span>
              )}
              {cell.practice.status === 'delivered' && <span class="delivered" aria-label="delivered">✓</span>}
            </button>
          ) : (
            <div
              class={`cell ${cell.inSeason ? `rest band-${cell.block}` : 'out'}`}
              id={cell.blockStartsHere ? `block-${cell.block}` : undefined}
            >
              <span class="num display">{cell.num}</span>
              {cell.inSeason && cell.sunday && <span class="tag muted">—</span>}
            </div>
          )
        )}
      </div>
    </section>
  ))}

  <p class="muted season-note">
    Season runs {SEASON_START} → {SEASON_END}. Tap any day for the practice card; link straight to a day
    with <code>#2026-11-16</code>.
  </p>

  <!-- one pre-rendered card per practice; the drawer clones the one it needs -->
  {sortedPractices.map((p) => (
    <template data-for={p.data.date}>
      <PracticeCard practice={p.data} moveNames={moveNames} compact />
    </template>
  ))}

  <div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
  <aside class="drawer" id="drawer" hidden aria-label="Practice">
    <div class="drawer-bar no-print">
      <button type="button" class="btn" id="drawer-close" aria-label="Close">✕ Close</button>
    </div>
    <div class="drawer-body" id="drawer-body"></div>
  </aside>
</Layout>

<style>
  .cal-legend {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }
  .legend-item {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .legend-sep { color: var(--line-strong); }
  .comp-key {
    width: 0;
    height: 0;
    border-style: solid;
    border-width: 0 14px 14px 0;
    border-color: transparent var(--score-red) transparent transparent;
    display: inline-block;
  }
  .check-key { color: var(--score-green); font-weight: 700; }
  .flag-key {
    color: var(--danger);
    font-weight: 700;
    border: 2px solid var(--danger);
    border-radius: 50%;
    width: 1.2em;
    height: 1.2em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.85em;
  }

  .month { margin-bottom: 2.25rem; }
  .month h2 { margin-bottom: 0.6rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 4px;
  }
  .dow {
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 0.9rem;
    color: var(--ink-soft);
    padding: 0.2rem 0.4rem;
  }
  .cell {
    position: relative;
    min-height: clamp(64px, 9vw, 96px);
    border-radius: 4px;
    padding: 0.35rem 0.45rem;
    text-align: left;
  }
  .cell.blank { background: transparent; }
  .cell.out {
    background: transparent;
    color: var(--line-strong);
  }
  .cell.rest {
    background: #e7e9e4;
    color: var(--ink-soft);
  }
  .cell.day {
    background: var(--card);
    border: 1px solid var(--line);
    border-top-width: 5px;
    cursor: pointer;
    font: inherit;
    color: inherit;
    display: block;
    width: 100%;
  }
  .cell.rest { border-top: 5px solid transparent; }
  .band-evaluate { border-top-color: var(--evaluate) !important; }
  .band-install { border-top-color: var(--install) !important; }
  .band-volume { border-top-color: var(--volume) !important; }
  .band-refine { border-top-color: var(--refine) !important; }
  .band-peak { border-top-color: var(--peak) !important; }

  .cell.day:active { transform: scale(0.98); }
  .cell.day:focus-visible {
    outline: 3px solid var(--install);
    outline-offset: 2px;
  }
  .cell.day.offday { background: #e7e9e4; }

  .num {
    font-size: 1.15rem;
    font-weight: 700;
  }
  .cell .tag {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    color: var(--ink-soft);
    margin-top: 0.1rem;
  }
  .cell.comp::after {
    content: '';
    position: absolute;
    top: -5px;
    right: 0;
    border-style: solid;
    border-width: 0 16px 16px 0;
    border-color: transparent var(--score-red) transparent transparent;
    border-top-right-radius: 3px;
  }
  .dots {
    position: absolute;
    left: 0.45rem;
    bottom: 0.4rem;
    display: flex;
    align-items: center;
    gap: 3px;
  }
  .dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--ink);
    display: inline-block;
  }
  .dots em {
    font-style: normal;
    font-size: 0.75rem;
    color: var(--ink-soft);
  }
  .delivered {
    position: absolute;
    right: 0.4rem;
    bottom: 0.25rem;
    color: var(--score-green);
    font-weight: 700;
  }
  /* runtime flags */
  .cell.day.overdue {
    border-color: var(--danger);
    box-shadow: inset 0 0 0 2px var(--danger);
  }
  .cell.day.overdue .tag::after {
    content: ' !';
    color: var(--danger);
    font-weight: 700;
  }
  .cell.day.today {
    box-shadow: 0 0 0 3px var(--ink);
  }

  .season-note { margin-top: -0.5rem; }

  /* ---- drawer --------------------------------------------------------- */
  .drawer-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(22, 25, 29, 0.45);
    z-index: 20;
  }
  .drawer {
    position: fixed;
    z-index: 21;
    background: var(--paper);
    box-shadow: -6px 0 24px rgba(0, 0, 0, 0.25);
    display: flex;
    flex-direction: column;
    /* landscape: right panel */
    top: 0;
    right: 0;
    bottom: 0;
    width: min(480px, 92vw);
    padding: 0.75rem;
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  @media (orientation: portrait) and (max-width: 700px) {
    .drawer {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      max-height: 82dvh;
      border-radius: 12px 12px 0 0;
      box-shadow: 0 -6px 24px rgba(0, 0, 0, 0.25);
    }
  }
  .drawer-bar {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 0.5rem;
  }
  .drawer[hidden], .drawer-backdrop[hidden] { display: none; }
</style>

<script>
  const drawer = document.getElementById('drawer')!;
  const backdrop = document.getElementById('drawer-backdrop')!;
  const body = document.getElementById('drawer-body')!;
  const closeBtn = document.getElementById('drawer-close')!;
  const DATE_RE = /^\d{4}-\d{2}-\d{2}$/;
  let openedByTap = false;

  function render(date: string): boolean {
    const tpl = document.querySelector<HTMLTemplateElement>(`template[data-for="${date}"]`);
    if (!tpl) return false;
    body.replaceChildren(tpl.content.cloneNode(true));
    drawer.hidden = false;
    backdrop.hidden = false;
    drawer.scrollTop = 0;
    closeBtn.focus();
    return true;
  }

  function hide() {
    drawer.hidden = true;
    backdrop.hidden = true;
  }

  function close() {
    if (openedByTap) {
      openedByTap = false;
      history.back(); // hashchange handler hides the drawer
    } else {
      hide();
      history.replaceState(null, '', location.pathname + location.search);
    }
  }

  function syncToHash() {
    const date = location.hash.slice(1);
    if (DATE_RE.test(date)) {
      if (!render(date)) hide();
    } else {
      hide();
    }
  }

  document.querySelectorAll<HTMLButtonElement>('.cell.day[data-date]').forEach((cell) => {
    cell.addEventListener('click', () => {
      openedByTap = true;
      location.hash = cell.dataset.date!; // fires hashchange → render
    });
  });

  closeBtn.addEventListener('click', close);
  backdrop.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !drawer.hidden) close();
  });
  window.addEventListener('hashchange', () => {
    openedByTap = false;
    syncToHash();
  });

  // runtime, not build time: the static build can be weeks old
  const today = new Date();
  const todayISO = new Date(today.getTime() - today.getTimezoneOffset() * 60000)
    .toISOString()
    .slice(0, 10);
  document.querySelectorAll<HTMLElement>('.cell.day[data-date]').forEach((cell) => {
    const date = cell.dataset.date!;
    if (date === todayISO) cell.classList.add('today');
    if (cell.dataset.status === 'planned' && date < todayISO) cell.classList.add('overdue');
  });

  syncToHash(); // deep link: /calendar#2026-11-16
</script>
