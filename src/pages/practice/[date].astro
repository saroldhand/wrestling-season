---
import Layout from '../../layouts/Layout.astro';
import PracticeCard from '../../components/PracticeCard.astro';
import CompetitionSummary from '../../components/CompetitionSummary.astro';
import { getCollection, render } from 'astro:content';
import { formatDay } from '../../lib/season.ts';
import { withBase } from '../../lib/url.ts';
import { loadPlanContext } from '../../lib/plan-context.ts';
import { compareCompetitions, competitionDays } from '../../lib/competitions.ts';

export async function getStaticPaths() {
  const practices = await getCollection('practices');
  return practices.map((entry) => ({ params: { date: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const p = entry.data;
const { Content } = await render(entry);

const moves = await getCollection('moves');
const moveNames = new Map(moves.map((m) => [m.data.id, m.data.name]));
const plan = await loadPlanContext();

const practices = await getCollection('practices');
const dates = practices
  .map((x) => x.data.date)
  .sort()
  .filter((d) => practices.find((x) => x.data.date === d)!.data.day_type !== 'off' || d === p.date);
const i = dates.indexOf(p.date);
const prev = i > 0 ? dates[i - 1] : null;
const next = i >= 0 && i < dates.length - 1 ? dates[i + 1] : null;

const meets = (await getCollection('competitions'))
  .filter((c) => competitionDays(c.data).includes(p.date))
  .sort((a, b) => compareCompetitions(a.data, b.data));

// "Mon 16" — short enough that prev / calendar / next fit one phone row
const navDay = (iso: string) => `${formatDay(iso, { weekday: 'short' })} ${formatDay(iso, { day: 'numeric' })}`;

const hasNotes = entry.body && entry.body.trim().replace(/^## After-practice notes\s*$/m, '').trim().length > 0;
---

<Layout title={`Practice ${p.date}`} description={`Practice plan for ${formatDay(p.date)}`}>
  <nav class="practice-nav no-print" aria-label="Practice navigation">
    {prev ? <a class="btn" href={withBase(`/practice/${prev}/`)} aria-label={`Previous: ${formatDay(prev)}`}>← {navDay(prev)}</a> : <span></span>}
    <a class="btn" href={withBase(`/calendar#${p.date}`)}>Calendar</a>
    <button type="button" class="btn print-btn" onclick="window.print()">Print</button>
    {next ? <a class="btn" href={withBase(`/practice/${next}/`)} aria-label={`Next: ${formatDay(next)}`}>{navDay(next)} →</a> : <span></span>}
  </nav>

  <header class="practice-header">
    <h1>
      <span class="date-long">{formatDay(p.date, { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' })}</span>
      <span class="date-short">{formatDay(p.date, { weekday: 'short', month: 'short', day: 'numeric' })}</span>
    </h1>
  </header>

  <div class="practice-sheet">
    {meets.map((m) => <CompetitionSummary id={m.id} competition={m.data} />)}
    <PracticeCard practice={p} moveNames={moveNames} plan={plan} showDate={false} />

    <section class="notes prose">
      <Content />
      {p.status === 'planned' && !hasNotes && (
        <p class="muted no-print">
          After {p.day_type === 'competition' ? 'the meet' : 'practice'}: set <code>status: delivered</code> in the file and write what actually
          happened under the notes heading — the record is the point.
        </p>
      )}
    </section>
  </div>
</Layout>

<style>
  .practice-nav {
    display: flex;
    gap: 0.5rem;
    justify-content: space-between;
    flex-wrap: wrap;
    margin-bottom: 1rem;
  }
  .practice-header h1 {
    margin-bottom: 0.75rem;
  }
  .date-short { display: none; }
  @media (max-width: 600px) {
    .date-long, .print-btn { display: none; }
    .date-short { display: inline; }
  }
  .practice-sheet {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 760px;
  }
  .notes {
    padding: 0 0.2rem;
  }

  /* print: one clean sheet for the whiteboard */
  @media print {
    .practice-header h1 {
      font-size: 20pt;
      margin: 0 0 8pt;
    }
    .practice-sheet {
      gap: 6pt;
      max-width: none;
    }
    .practice-sheet :global(.card) {
      border: none;
      padding: 0;
    }
    .practice-sheet :global(.chip) {
      border: none;
      padding: 0;
      min-height: 0;
      text-decoration: none;
    }
    .practice-sheet :global(.chip)::after {
      content: ' ·';
    }
    .practice-sheet :global(.pc-full) {
      display: none;
    }
    .notes {
      font-size: 10pt;
    }
  }
</style>
