---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDay } from '../../lib/season.ts';

export async function getStaticPaths() {
  const concepts = await getCollection('concepts');
  return concepts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const c = entry.data;
const { Content } = await render(entry);

// backlinks: anything whose body wikilinks [[this-id]]
const needle = new RegExp(`\\[\\[${c.id}(\\|[^\\]]*)?\\]\\]`);
const collections = ['moves', 'practices', 'blocks', 'concepts'] as const;
const backlinks: { name: string; href: string; kind: string }[] = [];
for (const name of collections) {
  const entries = await getCollection(name);
  for (const other of entries) {
    if (name === 'concepts' && other.id === c.id) continue;
    if (!needle.test(other.body ?? '')) continue;
    if (name === 'moves') backlinks.push({ name: (other.data as any).name, href: `/moves/${other.id}/`, kind: 'move' });
    else if (name === 'concepts') backlinks.push({ name: (other.data as any).name, href: `/concepts/${other.id}/`, kind: 'concept' });
    else if (name === 'blocks') backlinks.push({ name: (other.data as any).name, href: `/calendar#block-${other.id}`, kind: 'block' });
    else backlinks.push({ name: formatDay(other.id, { month: 'short', day: 'numeric' }), href: `/practice/${other.id}/`, kind: 'practice' });
  }
}
---

<Layout title={c.name} description={`${c.type}: ${c.name}`}>
  <header class="concept-header">
    <h1>{c.name}</h1>
    <p class="move-badges">
      <span class="badge">{c.type}</span>
      {c.tags.map((t) => <span class="muted">#{t}</span>)}
    </p>
  </header>

  <div class="concept-grid">
    <article class="prose">
      <Content />
    </article>

    <aside class="card linked">
      <h3>Linked from</h3>
      {backlinks.length === 0 ? (
        <p class="muted">Nothing links here yet.</p>
      ) : (
        <ul>
          {backlinks.map((b) => (
            <li>
              <a href={b.href}>{b.name}</a> <span class="muted">{b.kind}</span>
            </li>
          ))}
        </ul>
      )}
    </aside>
  </div>
</Layout>

<style>
  .concept-header { margin-bottom: 1rem; }
  .move-badges {
    display: flex;
    gap: 0.5rem;
    align-items: baseline;
    flex-wrap: wrap;
    margin: 0;
  }
  .concept-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(240px, 1fr);
    gap: 1.25rem;
    align-items: start;
  }
  @media (max-width: 820px) {
    .concept-grid { grid-template-columns: 1fr; }
  }
  .linked ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .linked li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    align-items: baseline;
    padding: 0.35rem 0;
    border-top: 1px solid var(--line);
  }
  .linked li:first-child { border-top: none; }
</style>
