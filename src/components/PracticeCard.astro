---
/**
 * The practice card: schedule blocks, primary/spiral moves, film, pod notes.
 * Used three ways — inside the calendar drawer, on /practice/[date], and on
 * the dashboard — so it renders from plain data, no collection calls here;
 * block templates and the idea bank arrive through `plan`.
 */
import type { Practice, SegmentKind } from '../lib/schemas.ts';
import { formatDay, MILESTONES } from '../lib/season.ts';
import { withBase } from '../lib/url.ts';
import { practiceTimeline, IDEA_TYPE, isPracticeDay } from '../lib/practice-plan.ts';
import type { PlanContext } from '../lib/plan-context.ts';

interface Props {
  practice: Practice;
  /** id → display name for move links */
  moveNames: Map<string, string>;
  /** drawer/dashboard mode: no big header, link to the full page */
  compact?: boolean;
  /** the practice page has the date as its H1 already */
  showDate?: boolean;
  /** block templates + idea bank, from loadPlanContext() */
  plan: PlanContext;
}

const { practice: p, moveNames, compact = false, showDate = true, plan } = Astro.props;

const moveLink = (id: string) => ({ id, name: moveNames.get(id) ?? id, href: withBase(`/moves/${id}/`) });
const primary = p.primary.map(moveLink);
const spiral = p.spiral.map(moveLink);
const film = p.film ? moveLink(p.film) : null;
const pods = (['blue', 'gold', 'white'] as const).filter((pod) => p.pod_notes[pod]);
const off = p.day_type === 'off';
const template = p.day_type === 'install' || p.day_type === 'volume' || p.day_type === 'sharpen' ? plan.templates.get(p.block)?.[p.day_type] : undefined;
const { segments, fromTemplate } = practiceTimeline(p, template);
// the idea bank for a segment, narrowed to ideas that fit this phase
const ideasFor = (kind?: SegmentKind) => {
  const type = kind && IDEA_TYPE[kind];
  return type ? (plan.ideas.get(type) ?? []).filter((i) => i.blocks.length === 0 || i.blocks.includes(p.block)) : [];
};
---

<article class="practice-card card" data-date={p.date} data-status={p.status}>
  <header class="pc-head">
    <div class="pc-when">
      {compact ? (
        <a class="pc-date display" href={withBase(`/practice/${p.date}/`)}>{formatDay(p.date, { weekday: 'short', month: 'short', day: 'numeric' })}</a>
      ) : (
        showDate && <span class="pc-date display">{formatDay(p.date)}</span>
      )}
      <span class={`badge solid block-${p.block}`}>{p.block}</span>
      <span class="badge">{isPracticeDay(p.day_type) ? `${p.day_type} day` : p.day_type}</span>
      <span class="badge">wk {p.week}</span>
      {p.status === 'delivered' ? (
        <span class="badge delivered">✓ delivered</span>
      ) : (
        <span class="badge planned" data-planned-badge>planned</span>
      )}
    </div>
    {isPracticeDay(p.day_type) && <span class="pc-duration display">{p.duration_min}′</span>}
  </header>

  {MILESTONES[p.date] && <p class="pc-milestone">{MILESTONES[p.date]}</p>}

  {off ? (
    <p class="muted">No practice — off day.</p>
  ) : (
    <>
      {segments.length > 0 ? (
        <>
          {fromTemplate && (
            <p class="muted pc-template">
              Default {p.block}-phase {p.day_type} day — write a <code>schedule</code> in the file to replace it.
            </p>
          )}
          <table class="pc-schedule">
            <tbody>
              {segments.map((s) => {
                const ideas = compact ? [] : ideasFor(s.kind);
                return (
                  <tr class={s.kind === 'water' ? 'seg-water' : undefined}>
                    <td class="t">{s.clock}</td>
                    <td class="len">{s.len}′</td>
                    <td>
                      <strong>{s.label}</strong>
                      {s.detail && <span class="muted"> — {s.detail}</span>}
                      {ideas.length > 0 && (
                        <details class="pc-ideas no-print">
                          <summary>{ideas.length} {s.label.toLowerCase()} ideas</summary>
                          <span class="idea-list">
                            {ideas.map((i) => <a class="idea" href={withBase(`/concepts/${i.id}/`)}>{i.name}</a>)}
                          </span>
                        </details>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </>
      ) : (
        <p class="muted pc-empty">{p.day_type === 'competition' ? 'Competition day.' : 'No schedule written yet.'}</p>
      )}

      {(primary.length > 0 || spiral.length > 0 || film) && (
        <dl class="pc-moves">
          {primary.length > 0 && (
            <>
              <dt>Primary</dt>
              <dd>{primary.map((m) => <a class="chip" href={m.href}>{m.name}</a>)}</dd>
            </>
          )}
          {spiral.length > 0 && (
            <>
              <dt>Spiral</dt>
              <dd>{spiral.map((m) => <a class="chip spiral" href={m.href}>{m.name}</a>)}</dd>
            </>
          )}
          {film && (
            <>
              <dt>Film</dt>
              <dd><a class="chip film" href={film.href}>{film.name}</a></dd>
            </>
          )}
        </dl>
      )}

      {pods.length > 0 && (
        <ul class="pc-pods">
          {pods.map((pod) => (
            <li>
              <span class={`pod-dot pod-${pod}`} aria-hidden="true"></span>
              <strong class="pod-name">{pod}</strong> {p.pod_notes[pod]}
            </li>
          ))}
        </ul>
      )}
    </>
  )}

  {compact && (
    <a class="btn pc-full no-print" href={withBase(`/practice/${p.date}/`)}>Full practice page</a>
  )}
</article>

<style>
  .practice-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .pc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .pc-when {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
  }
  .pc-date {
    font-size: 1.35rem;
    font-weight: 700;
    text-transform: uppercase;
    margin-right: 0.35rem;
  }
  a.pc-date {
    text-decoration: none;
  }
  a.pc-date:hover,
  a.pc-date:focus-visible {
    text-decoration: underline;
  }
  .pc-duration {
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--ink-soft);
  }
  .badge.delivered {
    color: var(--score-green);
  }
  .badge.planned {
    color: var(--ink-soft);
  }
  .badge.planned.overdue {
    color: var(--danger);
    background: var(--flag-bg);
  }

  .pc-schedule {
    border-collapse: collapse;
    width: 100%;
  }
  .pc-schedule td {
    border-top: 1px solid var(--line);
    padding: 0.45rem 0.5rem 0.45rem 0;
    vertical-align: baseline;
  }
  .pc-schedule tr:first-child td {
    border-top: 2px solid var(--ink);
  }
  .pc-schedule .t {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
    white-space: nowrap;
    width: 3.2rem;
  }
  .pc-schedule .len {
    color: var(--ink-soft);
    white-space: nowrap;
    width: 2.8rem;
  }
  .pc-schedule .seg-water td {
    color: var(--ink-soft);
    padding-top: 0.2rem;
    padding-bottom: 0.2rem;
  }
  .pc-schedule .seg-water strong {
    font-weight: 400;
  }
  .pc-template {
    margin: 0;
    font-size: 0.9rem;
  }
  .pc-milestone {
    margin: 0;
    padding: 0.45rem 0.8rem;
    border: 1.5px solid var(--ink);
    border-radius: var(--radius);
    background: var(--paper);
    font-weight: 600;
  }
  .pc-ideas {
    margin-top: 0.3rem;
  }
  .pc-ideas summary {
    cursor: pointer;
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.85rem;
    color: var(--install);
    min-height: 40px;
    display: flex;
    align-items: center;
  }
  .idea-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    padding: 0.3rem 0 0.2rem;
  }
  .idea {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.7rem;
    border: 1.5px solid var(--line-strong);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    background: var(--card);
  }

  .pc-moves {
    margin: 0;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.4rem 0.8rem;
    align-items: baseline;
  }
  .pc-moves dt {
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }
  .pc-moves dd {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 0.7rem;
    border: 1.5px solid var(--ink);
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    background: var(--card);
  }
  .chip.spiral {
    border-style: dashed;
    color: var(--ink-soft);
  }
  .chip.film {
    border-color: var(--install);
    color: var(--install);
  }

  .pc-pods {
    list-style: none;
    margin: 0;
    padding: 0.6rem 0 0;
    border-top: 1px solid var(--line);
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .pod-dot {
    display: inline-block;
    width: 0.8em;
    height: 0.8em;
    border-radius: 50%;
    margin-right: 0.35em;
  }
  .pod-blue { background: var(--install); }
  .pod-gold { background: var(--refine); }
  .pod-white { background: #fff; border: 1.5px solid var(--ink); }
  .pod-name {
    font-family: var(--display);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .pc-full {
    align-self: flex-start;
  }
  .pc-empty {
    margin: 0;
  }
</style>
